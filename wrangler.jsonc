{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pml",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],

  // ── SINGLE ENVIRONMENT (story 1.5, revised 2026-08-10) ──────────────────
  //
  // Originally built with env.staging/env.production per architecture.md's
  // early "dev/staging/prod" line. Patrick reconsidered: for a solo operator,
  // the real safety net is the human-in-the-loop approval queue (Epic 3), not
  // environment isolation — and two environments doubled every account-setup
  // step left in the deploy runbook (D1, domains, Access, secrets, Builds).
  // Cut back to one. Nothing here stops a later story from reintroducing
  // env.staging the same way it was built the first time, if it's ever
  // actually needed.
  //
  // Never mint a public hostname we did not ask for. `access.ts` verifies the
  // Access JWT precisely because workers_dev and preview URLs are doors
  // Access at the edge does not cover; the cheapest fix is for those doors
  // not to exist.
  "workers_dev": false,
  "preview_urls": false,

  // Private operator logs (story 1.4 review decision). The admin guard emits a
  // structured admin.access_denied event with a reason code on every refusal;
  // without somewhere to land it, a real lockout is indistinguishable from
  // "nobody tried". Private only — the public Evidence projection on ops. is a
  // separate concern owned by Epic 3.
  "observability": { "enabled": true },

  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    // Worker-owned API and agent routes MUST run the Worker first. The compat
    // flag assets_navigation_prefers_asset_serving is default-on for
    // compatibility dates >= 2025-04-01, so asset-eligible requests can
    // otherwise skip the Worker entirely — and a skipped Worker is a skipped
    // auth check or public API response.
    // Cloudflare documents run_worker_first as required when "performing any
    // authentication checks ... before serving static assets".
    //
    // Bare prefix roots are listed alongside their globs (`/api` + `/api/*`,
    // `/agents` + `/agents/*`): a trailing-slash glob does not match its bare
    // parent. More specific `/api/admin*` rules must not be duplicated because
    // `/api/*` already subsumes them and Wrangler rejects redundant siblings.
    //
    // `/admin` is deliberately NOT listed: it is the SPA document, it leaks
    // nothing (every band is an empty placeholder), and routing it through the
    // Worker buys nothing until Access is bound at the edge. Revisit when the
    // Zero Trust application exists (deploy runbook, part B).
    // Story 2.1 widened `/api/admin*` to all of `/api*`, because the public
    // read API added there would otherwise have been served as index.html.
    //
    // WHY THE WHOLE PREFIX, not just the new routes. Once `run_worker_first`
    // is an ARRAY, the router sets has_static_routing=true, and that flag is
    // the FIRST term of the asset-worker's canFetch check — so
    // not_found_handling stays "single-page-application" and every unlisted
    // path resolves to a real asset match. There is no Accept-header or
    // Sec-Fetch-Mode escape: a JSON fetch and an address-bar hit both get
    // 200 text/html, and the Worker is never invoked. The documented
    // navigation-only behaviour of assets_navigation_prefers_asset_serving
    // never gets evaluated, because has_static_routing short-circuits ahead
    // of it. Unlisted means unreachable, for every client.
    //
    // `/api` AND `/api/*` are both required: `/api/*` compiles to the anchored
    // regex /^\/api\/.*$/, which the bare path does not match. Same reason
    // `/agents` is listed beside `/agents/*`.
    //
    // Do NOT re-add `/api/admin` or `/api/admin/*`. Wrangler's
    // validateStaticRoutingRules REJECTS a rule that a sibling glob subsumes —
    // keeping them is a hard deploy failure ("rule '/api/*' makes it
    // redundant"), not harmless duplication. Both still run the Worker first;
    // they are covered by `/api/*`. `/agents` + `/agents/*` is legal by
    // contrast, because "/agents".startsWith("/agents/") is false.
    //
    // Side effect, deliberate: `/api/%61dmin/session` used to miss this
    // matcher (it tests the RAW pathname, while adminGuard.normalizePath
    // decodes) and was answered with index.html, so the guard never ran.
    // Nothing sensitive was served, but the admin API was unreachable by that
    // spelling. Under `/api/*` it reaches the Worker and normalizes correctly.
    //
    // Cost, also deliberate: paths listed here always invoke the Worker, so
    // public read traffic moves from free asset serving onto billed
    // invocations, and on the free tier excess returns 429 rather than
    // falling back to assets.
    "run_worker_first": [
      "/agents",
      "/agents/*",
      "/oauth",
      "/oauth/*",
      "/api",
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ChatAgent",
        "name": "ChatAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["ChatAgent"],
      "tag": "v1"
    }
  ],

  // Story 2.1 makes D1 canonical for the public F1 entities. `--local`
  // (Miniflare simulation) is used for development and tests; the database
  // below is the production store populated by Wrangler migrations.
  //
  // Created 2026-08-10 via the Cloudflare D1 API (name: pml, region: ENAM).
  //
  // Do NOT delete this block to "fix" a deploy error. Wrangler's automatic
  // provisioning is on by default: a binding with no database_id makes it
  // create a SECOND database and write the id back into this file — and when
  // the deploy runs from Workers Builds, that write is not persisted to the
  // repo. Production would silently drift from source.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pml",
      "database_id": "d07713fe-d0f1-4708-a174-394b04fc01b9",
      "migrations_dir": "migrations"
    }
  ],

  // Custom Domains, not route patterns: Custom Domains point ALL paths of a
  // hostname at the Worker and treat it as the origin, which is what serving
  // a whole site needs. Cloudflare creates the DNS record and manages the
  // certificate. Requires an active zone and no pre-existing CNAME on the
  // hostname.
  "routes": [
    {
      "pattern": "predictionmarketlitigation.com",
      "custom_domain": true
    },
    {
      "pattern": "ops.predictionmarketlitigation.com",
      "custom_domain": true
    }
  ]

  // Story 2.1 owns the F1 D1 schema, seed, and read-only public API.
  // Story 3.2 — AI Gateway binding/credentials via Worker secrets (never committed)
}

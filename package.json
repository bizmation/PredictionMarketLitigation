{
  "name": "pml",
  "version": "0.1.0",
  "private": true,
  "description": "PML (PredictionMarketLitigation) — litigation tracker + governed AI pipeline on Cloudflare",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "test": "vitest run",
    "build": "vite build",
    "deploy:staging": "cross-env CLOUDFLARE_ENV=staging vite build && wrangler deploy --env staging",
    "deploy:production": "cross-env CLOUDFLARE_ENV=production vite build && wrangler deploy --env production",
    "types": "wrangler types env.d.ts",
    "format": "oxfmt --write .",
    "lint": "oxlint src/",
    "check": "oxfmt --check . && oxlint src/ && tsc"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.9.3",
    "agents": "^0.17.4",
    "ai": "^6.0.197",
    "jose": "^6.2.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "workers-ai-provider": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "~4.1.10",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
